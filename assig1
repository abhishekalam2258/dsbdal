import pandas as pd
import numpy as np
from sklearn.preprocessing import LabelEncoder
from sklearn.preprocessing import MinMaxScaler

# Load Dataset
data = pd.read_csv("Titanic-Dataset.csv")

# Display first rows
print(data.head())

# Shape
print(data.shape)

# Data types
print(data.dtypes)

# Missing values
print(data.isnull().sum())

# Statistical summary
print(data.describe())

# Fill missing values
data['Age'] = data['Age'].fillna(data['Age'].mean())

# Type conversion
data['Age'] = data['Age'].astype(int)

# Label Encoding
le = LabelEncoder()
data['Sex'] = le.fit_transform(data['Sex'])

# Normalization
scaler = MinMaxScaler()
data[['Age', 'Fare']] = scaler.fit_transform(data[['Age', 'Fare']])

# Final output
print(data.head())
